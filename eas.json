{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "testflight": {
      "extends": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_TESTER_TOOLS": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6822011946",
        "appleTeamId": "T3PTQPU249"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6822011946",
        "appleTeamId": "T3PTQPU249"
      }
    }
  }
}
