{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/generate.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "lib/refs/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "cleanUrls": true
}
